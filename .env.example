SPARK_NETWORK=REGTEST
LNADDRESS_DOMAIN=localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Optional: the API host (registration and the Spark webhook), when it isn't PUBLIC_BASE_URL.
API_BASE_URL=
SERVER_MNEMONIC=
PORT=3000
MAX_SENDABLE_SATS=1000000
# Days a paid invoice (and its preimage) is kept for payment status lookups; unpaid ones go ~10 min after expiry.
INVOICE_RETENTION_DAYS=7
# Optional, at least 32 characters (openssl rand -hex 32). When set, Spark is asked to call
# API_BASE_URL/webhooks/spark when an invoice is paid, and polling slows to a backstop. Needs https.
SPARK_WEBHOOK_SECRET=
# Optional; enables Nostr zaps (NIP-57). An nsec1... or 64 hex characters. Per-address receipt keys are
# derived from it, so never change it once zaps are live: every earlier receipt would stop validating.
NOSTR_SECRET_KEY=

# MySQL connection (docker compose sets these for the app container)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lnaddress
DB_USER=lnaddress
DB_PASSWORD=
# 64 hex characters; encrypts usernames and pubkeys in the database. Generate: openssl rand -hex 32
# Losing it makes the stored data unreadable, so keep a copy in a password manager.
DATA_ENCRYPTION_KEY=
